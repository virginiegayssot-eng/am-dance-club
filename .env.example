# Supabase - get from https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase service role key - same page as above, "service_role" secret.
# Used by admin-only API routes (booking/pass/webhook logic) to bypass RLS.
# Never expose this to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe - get from https://dashboard.stripe.com/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Resend - get an API key from https://resend.com/api-keys
# RESEND_FROM must be a verified sender/domain in your Resend account.
RESEND_API_KEY=re_...
RESEND_FROM=you@yourdomain.com

# Cloudflare R2 (class video storage) - get from the R2 bucket's "Manage API tokens" page
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-access-key-id
R2_SECRET_ACCESS_KEY=your-secret-access-key
R2_BUCKET_NAME=your-bucket-name

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Where booking/payment notification emails are sent (does NOT grant access —
# instructor access is a role you set manually, see SETUP.md Step 5)
NEXT_PUBLIC_INSTRUCTOR_EMAIL=your@email.com

# Optional - shown as a "leave a review" link if set
GOOGLE_REVIEW_URL=

# Optional - shown as an "Also on ClassPass" link (Classes page + footer) if set
NEXT_PUBLIC_CLASSPASS_URL=
